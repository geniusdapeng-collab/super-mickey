# ============================================
# SuperMickey 环境变量配置
# 复制此文件为 .env 并填入真实值
# .env 不会被 git 提交（已在 .gitignore 中配置）
# ============================================

# ---------- LLM 配置（预生产管线必需，至少填一个） ----------
# LLMEngine 按 KIMI_API_KEY → MOONSHOT_API_KEY → KIMI_PLUGIN_API_KEY 顺序探测，
# 一个都未配置时管线无法运行（集成测试会打印未检测到 API Key）。
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 自定义 LLM 端点（可选；不填走默认端点）
# LLM_ENDPOINT=https://api.moonshot.cn/v1

# ---------- 火山引擎 / 方舟 API（渲染环节必需） ----------
# 方舟 API Key（以 ark- 开头）
# 获取方式：https://console.volcengine.com/ark/
ARK_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx

# Seedance 视频生成端点 ID（在方舟控制台创建自定义接入点获取）
SEEDANCE_ENDPOINT=ep-xxxxxxxxxxxxxxxxxxxxx

# Seedream 图片生成端点 ID
SEEDREAM_ENDPOINT=ep-xxxxxxxxxxxxxxxxxxxxx

# 基础 URL（一般不需要修改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com

# ---------- 人工确认服务（预生产确认闸门必需） ----------
# 签发/消费确认文件的共享密钥，任意长随机串即可
# 生成方式：openssl rand -hex 32
HUMAN_CONFIRMATION_SECRET=

# ---------- 可选：并发与运行调优 ----------
# 并发任务数限制
MAX_CONCURRENT_TASKS=3
# LLM 全局并发上限（默认 5）
# HYPERREALITY_LLM_MAX_CONCURRENCY=5

# ---------- 可选：模型与预算调优（SUPERMICKEY_* 系列） ----------
# LLM 模型名（默认 kimi-k2p6）
# SUPERMICKEY_LLM_MODEL=kimi-k2p6
# 快速通道模型名（默认跟随 SUPERMICKEY_LLM_MODEL）
# SUPERMICKEY_LLM_FAST_MODEL=kimi-k2p6
# 预生产总预算时长（毫秒，默认 3600000 = 60 分钟）
# SUPERMICKEY_TOTAL_DEADLINE_MS=3600000
# 长任务最短超时（毫秒，默认跟随 SUPERMICKEY_TOTAL_DEADLINE_MS）
# SUPERMICKEY_MIN_LONG_TASK_TIMEOUT_MS=3600000
# 创作意图（等价于 CLI 的 --input <json>）
# SUPERMICKEY_USER_INTENT={"story":"..."}
# 强制接管预生产单实例锁（危险，确认原进程已死才用）
# SUPERMICKEY_FORCE_RUN=0
#
# 兼容说明：引擎层历史变量名 STORMAXE_* 仍全部有效（systems/env-aliases.js
# 在入口启动时把 SUPERMICKEY_* 映射过去）；两个名字同时设置时 SUPERMICKEY_* 优先。
