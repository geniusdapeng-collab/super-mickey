# SuperMickey v2.1.0 生产环境配置
# 复制为 .env 并根据实际情况修改

# ==================== LLM 配置 ====================
# 主要模型（深度推理）
STORMAXE_LLM_MODEL=kimi-k2p6
# 备用模型（快速响应）
STORMAXE_LLM_FAST_MODEL=kimi-k2p5
# API Key（如果留空，将使用默认配置）
STORMAXE_API_KEY=

# ==================== PandaCineForge 配置 ====================
# 是否启用 PandaCineForge 技能引擎
PCF_ENABLED=false
# PandaCineForge 服务端点
PCF_ENDPOINT=http://127.0.0.1:8765
# 请求超时（毫秒）
PCF_TIMEOUT=5000
# OpenAI API Key（用于技能热生成，可选）
OPENAI_API_KEY=

# ==================== 渲染引擎配置 ====================
# Seedance API Key
SEEDANCE_API_KEY=
# 是否开启 dryRun 模式（不实际提交渲染）
SEEDANCE_DRY_RUN=false

# ==================== 日志配置 ====================
# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ==================== 性能配置 ====================
# Node.js 内存限制（MB）
NODE_MAX_MEMORY=2048
