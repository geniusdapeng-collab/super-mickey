{
  "autoTriggers": [
    {
      "name": "版本发布后",
      "condition": "创建 RELEASE-v*.md 文件后",
      "priority": "high"
    },
    {
      "name": "渲染提交后",
      "condition": "队长说'提交渲染'且全部succeeded",
      "priority": "medium"
    },
    {
      "name": "系统级修复后",
      "condition": "修复BLOCKING级别问题并发布",
      "priority": "high"
    },
    {
      "name": "预生产完成",
      "condition": "队长对预生产报告说OK",
      "priority": "medium"
    }
  ],
  "manualTriggers": [
    "复盘",
    "写战报",
    "记录这个坑",
    "沉淀经验",
    "出复盘文档"
  ],
  "dataSources": [
    "memory/YYYY-MM-DD.md",
    "对话历史",
    "SYSTEM.md",
    "RELEASE文件",
    "代码diff",
    "测试输出"
  ]
}