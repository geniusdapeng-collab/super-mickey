        "characters": [
          "chen-zhuo"
        ],
        "setting": "简洁的室内科普讲台，陈卓正对镜头",
        "dialogue": {
          "has_dialogue": true,
          "lines": [
            {
              "speaker": "chen-zhuo",
              "text": "大家好，我是陈卓。",
              "emotion": "亲和"
            },
            {
              "speaker": "chen-zhuo",
              "text": "今天聊聊横纹肌溶解，很多人听过但不懂。",
              "emotion": "认真"
            },
            {
              "speaker": "chen-zhuo",
              "text": "其实它离你不远。",
              "emotion": "神秘"
            }
          ]
        },
        "visual_notes": "陈卓身穿警服，短发干练，直视镜头，表情亲和",
        "emotional_target": {
          "valence": 0.7,
          "arousal": 0.5,
          "dominance": 0.6
        }
      },
      {
        "scene_id": "SC01",
        "scene_name": "概念解释",
        "scene_type": "establishing",
        "scene_function": "establish",
        "act_id": "ACT-1",
        "timing": {
          "start": 10,
          "duration": 10,
          "end": 20
        },
        "characters": [
          "chen-zhuo"
        ],
        "setting": "同一讲台，配合手势讲解",
        "dialogue": {
          "has_dialogue": true,
          "lines": [
            {
              "speaker": "chen-zhuo",
              "text": "简单说，就是肌肉细胞溶解了。",
              "emotion": "平静"
            },
            {
              "speaker": "chen-zhuo",
              "text": "肌肉里的东西漏进血液，把肾脏堵了。",
              "emotion": "严肃"
            },
            {
              "speaker": "chen-zhuo",
              "text": "严重会肾衰竭。",
              "emotion": "凝重"
            }
          ]
        },
        "visual_notes": "镜头近景，陈卓用手比划肌肉到肾脏的路径，画面简洁",
        "emotional_target": {
          "valence": 0.3,
          "arousal": 0.6,
          "dominance": 0.5
        }
      },
      {
        "scene_id": "SC02",
        "scene_name": "原因一：过度运动",
        "scene_type": "conflict",
        "scene_function": "advance",
        "act_id": "ACT-2",
        "timing": {
          "start": 20,
          "duration": 12,
          "end": 32
        },
        "characters": [
          "chen-zhuo"
        ],
        "setting": "同一空间，语气加快，情绪上升",
        "dialogue": {
          "has_dialogue": true,
          "lines": [
            {
              "speaker": "chen-zhuo",
              "text": "第一大原因，过度运动。",
              "emotion": "强调"
            },
            {
              "speaker": "chen-zhuo",
              "text": "突然剧烈运动，比如平时不练，突然做两百个深蹲。",
              "emotion": "举例"
            },
            {
              "speaker": "chen-zhuo",
              "text": "肌肉承受不住，直接崩溃。",
              "emotion": "警示"
            },
            {
              "speaker": "chen-zhuo",
              "text": "健身新手最容易中招。",
              "emotion": "关切"
            }
          ]
        },
        "visual_notes": "陈卓做深蹲手势，画面可叠加肌肉溶解示意图，节奏紧凑",
        "emotional_target": {
          "valence": 0.4,
          "arousal": 0.7,
          "dominance": 0.5
        }
      },
      {
        "scene_id": "SC03",
        "scene_name": "原因二：高温脱水",
        "scene_type": "conflict",
        "scene_function": "advance",
        "act_id": "ACT-2",
        "timing": {
          "start": 32,
          "duration": 12,
          "end": 44
        },
        "characters": [
          "chen-zhuo"
        ],
        "setting": "同一空间，表情严肃",
        "dialogue": {
          "has_dialogue": true,
          "lines": [
            {
              "speaker": "chen-zhuo",
              "text": "第二是高温脱水。",
              "emotion": "严肃"
            },
            {
              "speaker": "chen-zhuo",
              "text": "大夏天跑步不喝水，体温过高。",
              "emotion": "警示"
            },
            {
              "speaker": "chen-zhuo",
              "text": "肌肉在缺水高温下直接坏死。",
              "emotion": "凝重"
            },
            {
              "speaker": "chen-zhuo",
              "text": "记住，补水比补蛋白重要。",
              "emotion": "强调"
            }
          ]
        },
        "visual_notes": "陈卓做喝水手势，可配合高温警示图标，镜头保持稳定",
        "emotional_target": {
          "valence": 0.4,
          "arousal": 0.7,
          "dominance": 0.6
        }
      },
      {
        "scene_id": "SC04",
        "scene_name": "隐藏诱因",
        "scene_type": "emotional_climax",
        "scene_function": "climax",
        "act_id": "ACT-2",
        "timing": {
