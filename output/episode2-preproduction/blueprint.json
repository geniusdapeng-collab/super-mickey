        "characters": [
          "chen-zhuo"
        ],
        "setting": "同一空间，靠近镜头，语气加重",
        "dialogue": {
          "has_dialogue": true,
          "lines": [
            {
              "speaker": "chen-zhuo",
              "text": "还有些药物和创伤。",
              "emotion": "严肃"
            },
            {
              "speaker": "chen-zhuo",
              "text": "吃他汀类降脂药，或摔伤挤压。",
              "emotion": "解释"
            },
            {
              "speaker": "chen-zhuo",
              "text": "甚至吃小龙虾也可能诱发。",
              "emotion": "惊讶"
            },
            {
              "speaker": "chen-zhuo",
              "text": "原因很多，别大意。",
              "emotion": "警示"
            }
          ]
        },
        "visual_notes": "陈卓微微前倾，表情认真，可快速切换药物、创伤、食物的图标",
        "emotional_target": {
          "valence": 0.3,
          "arousal": 0.8,
          "dominance": 0.7
        }
      },
      {
        "scene_id": "SC05",
        "scene_name": "预防总结",
        "scene_type": "resolution",
        "scene_function": "resolve",
        "act_id": "ACT-3",
        "timing": {
          "start": 54,
          "duration": 8,
          "end": 62
        },
        "characters": [
          "chen-zhuo"
        ],
        "setting": "同一空间，恢复亲和语气",
        "dialogue": {
          "has_dialogue": true,
          "lines": [
            {
              "speaker": "chen-zhuo",
              "text": "肌肉酸痛、尿色深，赶紧就医。",
              "emotion": "关切"
            },
            {
              "speaker": "chen-zhuo",
              "text": "运动要循序渐进，别硬撑。",
              "emotion": "叮嘱"
            },
            {
              "speaker": "chen-zhuo",
              "text": "今天就说这些，关注我！",
              "emotion": "亲和"
            }
