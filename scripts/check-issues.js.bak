const fs = require('fs');
const report = JSON.parse(fs.readFileSync('/root/.openclaw/workspace/output/taotie-ep01-prompts-full.json', 'utf8'));
const preprod = JSON.parse(fs.readFileSync('/root/.openclaw/workspace/output/taotie-ep01-preproduction-2026-05-31T13-15-33-118Z.json', 'utf8'));

// 1. 检查 narration/台词问题
console.log('=== 1. NARRATION/台词分析 ===');
const storyboard = preprod.stages.output.storyboard;
if (storyboard && storyboard.shots) {
  storyboard.shots.forEach((shot, i) => {
    console.log('\n' + (shot.id || shot.shotId) + ':');
    console.log('  narration: ' + (shot.narration ? shot.narration.substring(0, 80) + '...' : '无'));
    console.log('  type: ' + (shot.type || 'unknown'));
    console.log('  mouthAction: ' + (shot.mouthAction || '无'));
    console.log('  characters: ' + JSON.stringify(shot.characters));
  });
}

// 2. 检查 S04/S05 的 prompt 中是否有详细的饕餮描述
console.log('\n=== 2. S04/S05 Prompt 中饕餮描述检查 ===');
const s04 = report.prompts.find(p => p.shotId === 'S04');
const s05 = report.prompts.find(p => p.shotId === 'S05');

console.log('\nS04 prompt (前300字):');
console.log(s04.prompt.substring(0, 300));

console.log('\nS05 prompt (前300字):');
console.log(s05.prompt.substring(0, 300));

// 检查是否包含关键描述词
const keyTerms = ['羊身', '人面', '腋下', '巨口', '利齿', '熔岩'];
console.log('\n=== 关键描述词检查 ===');
[s04, s05].forEach((p, idx) => {
  const shot = idx === 0 ? 'S04' : 'S05';
  const found = keyTerms.filter(term => p.prompt.includes(term));
  console.log(shot + ': 找到 ' + found.length + '/' + keyTerms.length + ' 个关键词: ' + found.join(', '));
});
