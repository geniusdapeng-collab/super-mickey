{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NirathPRD",
  "description": "Nirath Master Pipeline PRD Schema",
  "type": "object",
  "required": ["meta", "core", "scenes"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "mode": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "core": {
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "emotion": { "type": "string" },
        "pacing": { "type": "string" },
        "genre": { "type": "string" },
        "duration": { "type": "number" },
        "maxShots": { "type": "integer" }
      }
    },
    "world": {
      "type": "object",
      "properties": {
        "planet": { "type": "string" },
        "era": { "type": "string" },
        "dualStar": { "type": "boolean" },
        "bioluminescentEcosystem": { "type": "boolean" },
        "keyLocations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "characters": {
      "type": "object"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "narration"],
        "properties": {
          "id": { "type": "string" },
          "narration": { "type": "string", "minLength": 1 },
          "scene": { "type": "string" },
          "type": { "type": "string" },
          "importance": { "type": "string" },
          "characters": { "type": "array", "items": { "type": "string" } },
          "duration": { "type": "number" },
          "emotionPhase": { "type": "string" },
          "visualComplexity": { "type": "integer" },
          "mouthAction": { "type": "string" }
        }
      }
    },
    "style": {
      "type": ["string", "object"]
    },
    "constraints": {
      "type": "object"
    }
  }
}
